#!/bin/bash
set -euo pipefail

project_directory="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
workflow_directory="${project_directory}/workflow"
workflow_name="$(/usr/libexec/PlistBuddy -c 'Print :name' "${workflow_directory}/info.plist")"
workflow_file="${1:-${project_directory}/${workflow_name}.alfredworkflow}"
temporary_directory="$(mktemp -d "${TMPDIR:-/tmp}/alfred-folo.XXXXXX")"

cleanup() { rm -rf "${temporary_directory}"; }
trap cleanup EXIT

ditto "${workflow_directory}" "${temporary_directory}/workflow"
find "${temporary_directory}/workflow" -name '.DS_Store' -delete
npm install --prefix "${temporary_directory}/workflow" --omit=dev --ignore-scripts --no-audit --no-fund
DITTONORSRC=1 ditto -ck "${temporary_directory}/workflow" "${workflow_file}"
echo "Created ${workflow_file}"

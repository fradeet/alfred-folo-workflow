{
  "name": "folo-workflow",
  "version": "0.4.2",
  "private": true,
  "packageManager": "npm@11.13.0",
  "type": "module",
  "description": "An Alfred workflow for browsing and managing Folo feeds.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "install:workflow": "npm ci --prefix workflow",
    "build": "node scripts/build.mjs",
    "sync:readme": "node scripts/sync-readme.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && plutil -lint workflow/info.plist",
    "package": "./workflow-packager"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}

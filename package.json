{
  "name": "alfred-folo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An Alfred workflow for browsing and managing Folo feeds.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "install:workflow": "npm install --prefix workflow",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && plutil -lint workflow/info.plist",
    "package": "./workflow-packager"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}

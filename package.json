{
  "name": "folo-workflow",
  "version": "0.4.2",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "description": "An Alfred workflow for browsing and managing Folo feeds.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "install:workflow": "npm install --prefix workflow",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "pnpm run typecheck && pnpm test && pnpm run build && plutil -lint workflow/info.plist",
    "package": "./workflow-packager"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
